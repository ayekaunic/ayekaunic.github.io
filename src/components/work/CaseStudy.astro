---
import { getEntry, render } from 'astro:content';
import ProjectDiagram from './ProjectDiagram.astro';
interface Props { project: {id: string; number: string; title: string; formal: string; tech: string}; }
const { project } = Astro.props;
const overview = await getEntry('work', `${project.id}-overview`);
const story = await getEntry('work', project.id);
if (!overview || !story) throw new Error(`Missing work content: ${project.id}`);
const { Content: Overview } = await render(overview);
const { Content: Story } = await render(story);
---
<article class:list={['case-study', {'case-study-lead': project.number === '01'}]} id={project.id} aria-labelledby={`${project.id}-title`}>
  <header class="case-heading">
    <span class="eyebrow">{project.number} / {project.formal}</span>
    <h3 id={`${project.id}-title`}>{project.title}</h3>
    <p class="case-technologies">{project.tech}</p>
  </header>
  <div class="case-overview">
    <div class="work-copy"><Overview /></div>
    <ProjectDiagram kind={project.id} />
  </div>
  {project.id === 'website' && <a class="text-link project-link" href="https://www.foresight.com.pk/">visit Foresight Research ↗</a>}
  <details class="case-disclosure">
    <summary><span class="when-closed">read the full story ↓</span><span class="when-open">show less ↑</span><span class="sr-only"> — {project.formal}</span></summary>
    <div class="case-narrative work-copy"><Story /></div>
  </details>
</article>
