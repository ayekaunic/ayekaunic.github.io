---
interface Props { kind: string; }
const { kind } = Astro.props;
const diagrams: Record<string, {title: string; description: string; columns: string[][]; labels?: string[]}> = {
  'household-panel': { title: 'From interviews to usable records', description: 'ODK Central splits into two independent paths: survey data through Python ETL into SQL Server, quality checks, and operational review; attachments through a download worker into file storage.', columns: [['Survey data','Python ETL','SQL Server','Quality checks','Operational review'], ['Attachments','Download worker','File storage']] },
  frames: {title: 'A more repeatable release', description: 'Before: a manual build, copied to USB, then installed on each PC. After: code changes trigger GitHub Actions, an automated build, and Nextcloud distribution.', labels: ['BEFORE','AFTER'], columns: [['Manual build','Copy to USB','Install on each PC'],['Code changes','GitHub Actions','Automated build','Nextcloud distribution']]},
  infrastructure: {title: 'Backups with a way back', description: 'SQL Server feeds scheduled backups, replicated using SFTP to a separate Linux server. Restoration from a replicated backup has been successfully tested.', columns: [['SQL Server','Scheduled backup','SFTP replication','Separate Linux server','Tested restoration']]},
  website: {title: 'From design to deployment', description: 'Design and development in Next.js produce a static build, with GitHub Actions automating deployment to hosting.', columns: [['Design + development','Next.js','Static build','GitHub Actions','Hosting']]},
};
const diagram = diagrams[kind];
const split = diagram.columns.length > 1;
const household = kind === 'household-panel';
const top = household ? 100 : diagram.labels ? 42 : 16;
const height = top + Math.max(...diagram.columns.map(c => c.length)) * 65;
const markerId = `${kind}-arrow`;
---
<figure class:list={['project-diagram', { 'diagram-split': split }]}>
  <figcaption><span class="eyebrow">{diagram.title}</span><span aria-hidden="true">↳</span></figcaption>
  <svg viewBox={`0 0 360 ${height}`} role="img" aria-labelledby={`${kind}-diagram-title ${kind}-diagram-desc`}>
    <title id={`${kind}-diagram-title`}>{diagram.title}</title>
    <desc id={`${kind}-diagram-desc`}>{diagram.description}</desc>
    <defs><marker id={markerId} viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M1 1 L7 4 L1 7" fill="none" stroke="currentColor" /></marker></defs>
    {household && <g><rect x="100" y="12" width="160" height="42"/><text x="180" y="38">ODK Central</text><path d="M180 54 V76 H88 V96" marker-end={`url(#${markerId})`}/><path d="M180 76 H272 V96" marker-end={`url(#${markerId})`}/></g>}
    {diagram.columns.map((column, col) => {
      const x = split ? col * 184 + 4 : 70;
      const width = split ? 168 : 220;
      return <g>
        {diagram.labels && <text class="diagram-label" x={x+width/2} y="20">{diagram.labels[col]}</text>}
        {column.map((label, row) => <g>
          <rect x={x} y={top+row*65} width={width} height="42"/>
          <text x={x+width/2} y={top+row*65+26}>{label}</text>
          {row < column.length-1 && <path d={`M${x+width/2} ${top+row*65+42} v19`} marker-end={`url(#${markerId})`}/>}
        </g>)}
      </g>;
    })}
  </svg>
</figure>
