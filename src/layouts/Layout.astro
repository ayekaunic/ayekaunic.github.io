---
import '@fontsource-variable/dm-sans';
import '../styles/global.css';
interface Props { title?: string; description?: string; }
const { title = 'aun - thinking out loud.', description = 'belief. consistency. attention to detail. A small corner of the internet for thoughts, things worth sharing, and figuring it out.' } = Astro.props;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} /><meta name="theme-color" content="#fafafa" />
    <title>{title}</title><link rel="icon" href="/favicon.ico" />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:type" content="website" /><meta property="og:url" content={new URL(path, Astro.site)} />
    <link rel="alternate" type="application/rss+xml" title="aun - shower thoughts" href="/index.xml" />
  </head>
  <body>
    <a class="skip" href="#main">skip to content</a>
    <header class="header shell">
      <a class="wordmark" href="/" aria-label="aun, home">aun<span>_</span></a>
      <nav aria-label="Main navigation">
        <a href="/shower-thoughts/" aria-current={path.startsWith('/shower-thoughts') ? 'page' : undefined}>shower thoughts<span class="nav-dot"></span></a>
        <a href="/recommendations/" aria-current={path.startsWith('/recommendations') ? 'page' : undefined}>recommendations<span class="nav-dot"></span></a>
        <a class="hello-link" href="mailto:aun@ayekaunic.com">say hello <span>↗</span></a>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="footer shell">
      <div><a class="footer-title" href="mailto:aun@ayekaunic.com">something on<br/>your mind? <span>↗</span></a></div>
      <div class="footer-bottom"><a href="/">aun / ayekaunic</a><span>still figuring it out.</span><a href="/index.xml">follow via rss ↗</a><a href="#top" data-top>back to top ↑</a></div>
    </footer>
    <script src="../scripts/motion.ts"></script>
  </body>
</html>
