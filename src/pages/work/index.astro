---
import Layout from '../../layouts/Layout.astro';
import CaseStudy from '../../components/work/CaseStudy.astro';
import work from '../../data/work.json';
import '../../styles/work.css';
const contacts = [
  {label: 'GitHub', text: 'Code and projects', href: 'https://github.com/ayekaunic'},
  {label: 'LinkedIn', text: 'Professional background', href: 'https://www.linkedin.com/in/ayekaunic/'},
];
---
<Layout title="work - aun" description="Software engineering, data infrastructure, and automation by Aun: household data pipelines, application modernization, reliable backups, and a company website rebuild.">
  <div class="work-page shell" id="top">
    <section class="work-hero" aria-labelledby="work-title">
      <span class="eyebrow">work / a few things i've built</span>
      <h1 id="work-title">hi, i'm aun</h1>
      <div class="work-introduction work-copy">{work.intro.map(paragraph => <p>{paragraph}</p>)}</div>
      <a class="text-link" href="#selected-work">take a look ↓</a>
    </section>
    <section id="selected-work" aria-labelledby="selected-work-title">
      <div class="work-section-label"><h2 id="selected-work-title">selected work</h2><span class="eyebrow">01—04 / Foresight Research</span></div>
      {work.projects.map(project => <CaseStudy project={project} />)}
    </section>
    <section class="work-section" aria-labelledby="experience-title">
      <h2 id="experience-title">where i've been</h2>
      <div class="experience-list">{work.experience.map(position => <article class="experience-row">
        <p class="experience-date">{position.dates}</p>
        <div><h3>{position.org}</h3><p class="experience-role">{position.role}</p><div class="work-copy">{position.paragraphs.map(paragraph => <p>{paragraph}</p>)}</div></div>
      </article>)}</div>
    </section>
    <section class="work-section" aria-labelledby="toolkit-title">
      <h2 id="toolkit-title">things i work with</h2>
      <dl class="toolkit">{work.toolkit.map(item => <div><dt>{item.label}</dt><dd>{item.text}</dd></div>)}</dl>
    </section>
    <section class="work-section work-contact" aria-labelledby="contact-title">
      <h2 id="contact-title">elsewhere on the internet</h2>
      <div class="work-copy"><p>I'm usually working on something, learning something, or trying to understand why something isn't working.</p><p>If you'd like to see more of what I do, you can find me here:</p></div>
      <div class="contact-list">{contacts.map(contact => <a class="contact-row" href={contact.href} target="_blank" rel="noopener noreferrer"><strong>{contact.label}<span class="sr-only"> (opens in a new tab)</span></strong><span>{contact.text}</span><span aria-hidden="true">↗</span></a>)}</div>
      <div class="work-copy contact-closing"><p>Or just get in touch.</p><a class="contact-email" href="mailto:aun@ayekaunic.com">aun@ayekaunic.com ↗</a></div>
    </section>
  </div>
</Layout>
