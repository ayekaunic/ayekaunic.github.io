---
import Layout from '../../layouts/Layout.astro';
const categories = [{id:'books',text:'pages worth turning.'},{id:'movies',text:'stories worth your evening.'},{id:'shows',text:'one more episode.'},{id:'videos',text:'a little perspective.'}];
---
<Layout title="recommendations — aun"><section class="shell archive" id="top"><span class="eyebrow">the collection / recommendations</span><h1>recommendations.</h1><p class="collection-intro">a few things i'm glad i found.<br/>passed along in case you find something in them, too.</p><div class="category-list">{categories.map((category,i)=><a class="category-row" href={`/recommendations/${category.id}/`} data-reveal><span class="eyebrow">0{i+1}</span><h2>{category.id}</h2><p>{category.text}</p><span class="row-arrow">↗</span></a>)}</div></section></Layout>
