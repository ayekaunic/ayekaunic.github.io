---
import Layout from '../../layouts/Layout.astro';
import { getThoughts, dateLabel, readingTime } from '../../lib/content';
const thoughts = await getThoughts();
---
<Layout title="shower thoughts — aun"><section class="shell archive" id="top"><span class="eyebrow">the notebook / {String(thoughts.length).padStart(2,'0')} thoughts so far</span><h1>shower<br/><em>thoughts.</em></h1><div class="archive-intro"><p>some things make more sense<br/>when you write them down.</p><label class="search-label">find a thought<input type="search" id="thought-search" placeholder="a word, a feeling, an idea…" /></label></div><div class="archive-list">{thoughts.map((post,i)=><a class="archive-row" href={`/shower-thoughts/${post.id}/`} data-search={`${post.data.title} ${post.body}`.toLowerCase()}><span class="row-index">{String(thoughts.length-i).padStart(2,'0')}</span><h2>{post.data.title}</h2><span class="archive-meta">{dateLabel(post.data.date)}<small>{readingTime(post.body)} min read</small></span><span class="row-arrow">↗</span></a>)}</div><p id="no-results" role="status" hidden>no thoughts found. try another word?</p><p class="archive-count" id="search-status" aria-live="polite"></p></section></Layout>
<script>
  const search = document.querySelector<HTMLInputElement>('#thought-search');
  const rows = [...document.querySelectorAll<HTMLElement>('[data-search]')];
  search?.addEventListener('input', () => { const query = search.value.toLowerCase().trim(); let count = 0; rows.forEach(row=>{ row.hidden = !row.dataset.search?.includes(query); if (!row.hidden) count++; }); document.querySelector<HTMLElement>('#no-results')!.hidden = count !== 0; document.querySelector('#search-status')!.textContent = query ? `${count} ${count === 1 ? 'thought' : 'thoughts'} found` : ''; });
</script>
