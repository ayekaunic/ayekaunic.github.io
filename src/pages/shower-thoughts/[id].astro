---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { getThoughts, dateLabel, readingTime, excerpt } from '../../lib/content';
export async function getStaticPaths() { const posts = await getThoughts(); return posts.map((post,i)=>({params:{id:post.id}, props:{post,next: posts[(i+1)%posts.length]}})); }
const {post,next} = Astro.props;
const { Content } = await render(post);
---
<Layout title={`${post.data.title} — aun`} description={excerpt(post.body)}><div class="reading-progress" aria-hidden="true"></div><article class="article shell" id="top"><a class="text-link" href="/shower-thoughts/">← all shower thoughts</a><header class="article-heading"><div class="eyebrow"><time datetime={post.data.date}>{dateLabel(post.data.date)}</time><span> / {readingTime(post.body)} min read</span></div><h1>{post.data.title}<span class="orange">.</span></h1></header><div class="prose"><Content /></div><div class="article-end"><p>thanks for sitting with this.</p><a href="mailto:aun@ayekaunic.com">got a thought? say hello ↗</a></div><a class="next-thought" href={`/shower-thoughts/${next.id}/`}><span class="eyebrow">another thought to sit with</span><h2>{next.data.title} <span>↗</span></h2></a></article></Layout>
