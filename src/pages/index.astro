---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { getThoughts, dateLabel, readingTime } from '../lib/content';
const thoughts = await getThoughts();
const picks = await getCollection('recommendations');
const pickCount = (id: string) => String((picks.find(p => p.id === id)?.body?.match(/^- /gm) || []).length).padStart(2, '0');
const quotedThoughts = thoughts.filter(post => post.data.heroQuote?.trim());
const featuredThought = quotedThoughts[0];
const heroQuote = featuredThought?.data.heroQuote?.replace(/\s+/g, ' ').trim() || 'thinking out loud.';
const fragments = quotedThoughts.slice(1, 4);
const words = heroQuote.split(' ');
// Balance the composition by text length rather than assuming seven words.
const lineCount = Math.min(3, words.length);
const lines: string[][] = [];
let remaining = [...words];
for (let row = 0; row < lineCount; row++) {
  const rowsLeft = lineCount - row;
  const target = remaining.join(' ').length / rowsLeft;
  const line: string[] = [];
  while (remaining.length > rowsLeft - 1) {
    const next = remaining[0];
    const currentLength = line.join(' ').length;
    if (line.length && Math.abs(currentLength - target) < Math.abs(currentLength + next.length + 1 - target)) break;
    line.push(remaining.shift()!);
  }
  lines.push(line);
}
if (remaining.length) lines[lines.length - 1].push(...remaining);
const longestLine = Math.max(...lines.map(line => [...line.join(' ')].length));
const heroSize = Math.min(10.4, 115 / longestLine);
const sourceUrl = featuredThought ? `/shower-thoughts/${featuredThought.id}/` : '/shower-thoughts/';
---
<Layout title="aun - thinking out loud.">
  <section class="word-experiment" id="top" aria-label="An introduction in motion">
    <div class="word-stage">
      <div class="experiment-meta"><span>inside aun's head / a few things in motion</span><a href="#thoughts">skip to the thoughts ↓</a></div>
      {fragments.length > 0 && <div class="fragment-field" aria-label="Fragments from the notebook">
        {fragments.map((post, index) => <a class={`fragment fragment-${['one', 'two', 'three'][index]}`} href={`/shower-thoughts/${post.id}/`}>{post.data.heroQuote}</a>)}
      </div>}
      <h1 class="statement dynamic-statement" style={`--hero-size: ${heroSize}vw;`} aria-label={heroQuote}>{lines.map((line, row) => <span class={`statement-line line-${row}`} aria-hidden="true">{line.map(word => <span class="statement-word" data-word><span class="word-body">{[...word].map(letter => <span class="glyph">{letter}</span>)}</span></span>)}</span>)}</h1>
      <div class="experiment-bottom"><p>hey, i'm aun.<br/>these are the things i think about.</p><a class="statement-source" href={sourceUrl}>{featuredThought ? 'sit with this thought.' : 'explore the notebook.'}<span>{featuredThought ? `from “${featuredThought.data.title}” ↗` : 'all shower thoughts ↗'}</span></a><span class="scroll-cue">scroll to make sense of it ↓</span></div>
    </div>
  </section>
  <section class="thought-section shell" id="thoughts">
    <div class="section-heading"><div><span class="eyebrow">01 / the words settle. the thinking doesn't.</span><h2>shower<br/><em>thoughts.</em></h2></div><div class="index-aside"><p>no grand conclusions.<br/>just things worth sitting with.</p><a class="text-link" href="/shower-thoughts/">search the notebook ↗</a></div></div>
    <div class="home-index">{thoughts.map((post,i)=><a class="index-row" href={`/shower-thoughts/${post.id}/`}><span class="row-index">{String(thoughts.length-i).padStart(2,'0')}</span><h3>{post.data.title}</h3><span class="index-date"><time datetime={post.data.date}>{dateLabel(post.data.date)}</time><small>{readingTime(post.body)} min</small></span><span class="row-arrow">↗</span></a>)}</div>
    <div class="random-line"><span>or don't overthink it.</span><button id="random-thought" data-paths={JSON.stringify(thoughts.map(p=>`/shower-thoughts/${p.id}/`))}>pick one for me ↗</button></div>
  </section>
  <section class="good-section shell">
    <div class="section-heading"><div><span class="eyebrow">02 / things i'm glad i found</span><h2>recommendations<span class="period">.</span></h2></div><p>borrow a little perspective.</p></div>
    <div class="good-list">{[{id:'books',label:'a different perspective'},{id:'movies',label:'a couple of hours'},{id:'shows',label:'one more episode'},{id:'videos',label:'a little spark'}].map(item=><a href={`/recommendations/${item.id}/`} class="good-row"><span class="good-name">{item.id}</span><span class="good-description">{item.label}</span><span class="good-count">[{pickCount(item.id)}]</span><span class="row-arrow">↗</span></a>)}</div>
  </section>
</Layout>
